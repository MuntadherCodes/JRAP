<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>dev.hmcodes.jrap</groupId>
  <artifactId>jrap-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>JRAP — Journal Readiness Audit Platform</name>
  <description>AI-assisted, evidence-based Scopus-readiness auditing of scholarly journals (SRS v1.0)</description>

  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
    <totp.version>1.7.1</totp.version>
    <zonky.spring-test.version>2.5.1</zonky.spring-test.version>
    <zonky.postgres.version>2.0.7</zonky.postgres.version>
  </properties>

  <modules>
    <module>jrap-common</module>
    <module>jrap-tenancy</module>
    <module>jrap-crawl</module>
    <module>jrap-extract</module>
    <module>jrap-integrations</module>
    <module>jrap-registry</module>
    <module>jrap-analysis</module>
    <module>jrap-review-reporting</module>
    <module>jrap-ai-gateway</module>
    <module>jrap-api</module>
    <module>jrap-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.samstevens.totp</groupId>
        <artifactId>totp</artifactId>
        <version>${totp.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-database-spring-test</artifactId>
        <version>${zonky.spring-test.version}</version>
      </dependency>
      <dependency>
        <groupId>io.zonky.test</groupId>
        <artifactId>embedded-postgres</artifactId>
        <version>${zonky.postgres.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
